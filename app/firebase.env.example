# Salin nilai dari Firebase Console → Project settings → Your apps.
# Build Flutter dengan dart-define, contoh:
#
# flutter run \
#   --dart-define=FIREBASE_API_KEY=... \
#   --dart-define=FIREBASE_APP_ID=... \
#   --dart-define=FIREBASE_MESSAGING_SENDER_ID=... \
#   --dart-define=FIREBASE_PROJECT_ID=...
#
# Android: salin google-services.json ke app/android/app/google-services.json
# iOS: salin GoogleService-Info.plist ke app/ios/Runner/GoogleService-Info.plist
#
# Backend (api/.env):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

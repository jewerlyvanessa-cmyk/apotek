# Contoh konfigurasi nginx untuk instalasi beli putus on-prem.
# Salin ke /etc/nginx/sites-available/apotikflow lalu:
#   sudo ln -s /etc/nginx/sites-available/apotikflow /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Sesuaikan:
#   - server_name
#   - root (path Flutter web build)
#   - upstream API (port 3000)

upstream apotikflow_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name apotikflow.lan;

    client_max_body_size 20m;

    # Flutter web (opsional — jika tidak pakai APK/installer)
    root /var/www/apotikflow-web;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API NestJS
    location /api/ {
        proxy_pass http://apotikflow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Swagger (nonaktifkan di production publik jika tidak diperlukan)
    location /docs {
        proxy_pass http://apotikflow_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Socket.IO / WebSocket
    location /socket.io/ {
        proxy_pass http://apotikflow_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400s;
    }
}

# HTTPS (disarankan untuk produksi — gunakan certbot atau sertifikat internal)
# server {
#     listen 443 ssl http2;
#     server_name apotikflow.lan;
#     ssl_certificate     /etc/ssl/certs/apotikflow.crt;
#     ssl_certificate_key /etc/ssl/private/apotikflow.key;
#     # ... salin blok location di atas ...
# }

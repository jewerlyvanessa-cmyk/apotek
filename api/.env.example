# API umum — role apotikflow_app (tidak bisa INSERT/UPDATE/DELETE tenants)
DATABASE_URL="postgresql://apotikflow_app:apotikflow_app_secret@localhost:5432/apotikflow?schema=public"
# Modul Platform (Super Admin) — role apotikflow_platform
PLATFORM_DATABASE_URL="postgresql://apotikflow_platform:apotikflow_platform_secret@localhost:5432/apotikflow?schema=public"
# Prisma migrate/db push — user owner DB (postgres atau apotikflow lama)
# DATABASE_URL_MIGRATE="postgresql://apotikflow:apotikflow_secret@localhost:5432/apotikflow?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="3600"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="604800"
PORT=3000
API_PREFIX="api/v1"
CORS_ORIGIN="*"
# saas = multi-tenant berlangganan | on_prem = beli putus di server pembeli
DEPLOYMENT_MODE="saas"
# Dev lokal (uji generate + aktivasi sekaligus):
# DEPLOYMENT_MODE="on_prem"
# LICENSE_SECRET="sama-dengan-saat-generate-lisensi"
# ENABLE_PLATFORM="true"
# On-prem: kunci lisensi (atau aktifkan via POST /license/activate)
# LICENSE_KEY=""
# LICENSE_SECRET=""
# LICENSE_FILE_PATH=""
# LICENSE_GRACE_DAYS="7"
# SaaS: nonaktifkan modul platform jika perlu
# ENABLE_PLATFORM="true"
# Opsional — tanpa Redis/Docker, API memakai cache in-memory (cukup untuk dev)
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_PREFIX="apotikflow"
# QRIS webhook — wajib di production (header x-webhook-secret)
# QRIS_WEBHOOK_SECRET="random-long-secret"
# QRIS_PROVIDER="mock" | "http" | "xendit" | "midtrans"
# Mock lokal: node scripts/qris-mock-provider.mjs lalu QRIS_PROVIDER=http QRIS_API_URL=http://127.0.0.1:3999/v1/charges
# Xendit: QRIS_PROVIDER=xendit QRIS_XENDIT_SECRET_KEY="xnd_..."
# Midtrans: QRIS_PROVIDER=midtrans QRIS_MIDTRANS_SERVER_KEY="SB-Mid-..." QRIS_MIDTRANS_SANDBOX="true"
# QRIS_CALLBACK_URL="https://your-api.example.com/api/v1/payments/qris/webhook"
# QRIS_BASE_URL="https://api.qris-provider.com/charge"
# QRIS_API_URL="https://api.qris-provider.com/v1/charges"
# QRIS_API_KEY="your-api-key"
# Monitoring (opsional — aktifkan SENTRY_DSN untuk kirim error ke Sentry)
# SENTRY_DSN="https://xxx@o123.ingest.sentry.io/456"
# SENTRY_TRACES_SAMPLE_RATE="0.1"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Billing SaaS otomatis (webhook gateway pembayaran)
# BILLING_WEBHOOK_SECRET="random-long-secret"
# BILLING_SUSPEND_CRON="0 30 7 * * *"
# Email alert langganan (opsional — tanpa SMTP hanya log + WebSocket)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@apotikflow.com"
